WECOM_WEBHOOK_URL=

# 同时监控的服务器标识，用英文逗号分隔。
# 标识只能包含字母、数字和下划线，并且必须以字母开头。
# 每个标识对应一组 SUB2API_SERVER_<标识大写>_ 配置。
SUB2API_SERVERS=main,backup

SUB2API_SERVER_MAIN_NAME=主服务器
SUB2API_SERVER_MAIN_BASE_URL=http://10.0.0.1:8080
SUB2API_SERVER_MAIN_EMAIL=
SUB2API_SERVER_MAIN_PASSWORD=

SUB2API_SERVER_BACKUP_NAME=备用服务器
SUB2API_SERVER_BACKUP_BASE_URL=http://10.0.0.2:8080
SUB2API_SERVER_BACKUP_EMAIL=
SUB2API_SERVER_BACKUP_PASSWORD=

# 只监控一台、且不使用 SUB2API_SERVERS 时，仍可填写下面这一组。
# SUB2API_NAME=默认服务器
# SUB2API_BASE_URL=http://10.0.0.1:8080
# SUB2API_EMAIL=
# SUB2API_PASSWORD=

# 两个预计总费用指标的告警阈值
ESTIMATED_COST_THRESHOLD=500

# 单个账号 5h / 7d 剩余比例阈值
QUOTA_REMAIN_PERCENT=20

# 相同告警状态的静默时间
ALERT_COOLDOWN_MINUTES=60

# 定时巡检间隔，单位分钟。npm run hourly 使用
CHECK_INTERVAL_MINUTES=60

# 每页账号数量
PAGE_SIZE=100

# 可选：接口请求超时
REQUEST_TIMEOUT_MS=30000
