WECOM_WEBHOOK_URL=

# 同时监控的服务器标识，用英文逗号分隔。
# 标识只能包含字母、数字和下划线，并且必须以字母开头。
# 每个标识对应一组 SUB2API_SERVER_<标识大写>_ 配置。
SUB2API_SERVERS=main,backup

SUB2API_SERVER_MAIN_NAME=主服务器
SUB2API_SERVER_MAIN_BASE_URL=http://10.0.0.1:8080
SUB2API_SERVER_MAIN_EMAIL=
SUB2API_SERVER_MAIN_PASSWORD=

SUB2API_SERVER_BACKUP_NAME=备用服务器
SUB2API_SERVER_BACKUP_BASE_URL=http://10.0.0.2:8080
SUB2API_SERVER_BACKUP_EMAIL=
SUB2API_SERVER_BACKUP_PASSWORD=

# 设为 false 时保留该服务器配置，但巡检会跳过它。默认开启。
# SUB2API_SERVER_BACKUP_ENABLED=false

# 每台服务器可单独设置分组范围：all 或 selected。
# selected 时按分组名称用英文逗号分隔。页面保存后以 data/monitor-config.json 为准。
# SUB2API_SERVER_MAIN_GROUP_SCOPE=selected
# SUB2API_SERVER_MAIN_GROUPS=分组A,分组B
# 关闭后仍监控分组，但不再计算这台服务器的全账号预计总费用。默认开启。
# SUB2API_SERVER_MAIN_MONITOR_ALL_ACCOUNTS=false
# 这台服务器的全账号合计和分组预计总费用都使用这个阈值，单位 USD。
# 未单独设置时沿用 ESTIMATED_COST_THRESHOLD。
# SUB2API_SERVER_MAIN_ESTIMATED_COST_THRESHOLD=500

# 只监控一台、且不使用 SUB2API_SERVERS 时，仍可填写下面这一组。
# SUB2API_NAME=默认服务器
# SUB2API_BASE_URL=http://10.0.0.1:8080
# SUB2API_EMAIL=
# SUB2API_PASSWORD=

# 单台服务器未单独设置预计总费用阈值时使用，单位 USD。
ESTIMATED_COST_THRESHOLD=500

# 单个账号 5h / 7d 剩余比例阈值
QUOTA_REMAIN_PERCENT=20

# 相同告警状态的静默时间
ALERT_COOLDOWN_MINUTES=60

# 单台服务器未单独设置时，用这个值决定是否开启全账号预计总费用告警。
MONITOR_ALL_ACCOUNTS=true

# 定时巡检间隔，单位分钟。npm run hourly 使用
CHECK_INTERVAL_MINUTES=60

# 每页账号数量
PAGE_SIZE=100

# 可选：接口请求超时
REQUEST_TIMEOUT_MS=30000
